{
  "manifest_version": 2,
  "name": "Expiring Links for Self-Hosted Cloud Storage",
  "short_name": "Expiring Links",
  "description": "Filelink provider with expiring, password-protected and one-time download links. Works with Nextcloud; tested on Nextcloud 35.",
  "version": "0.4.0",
  "author": "Andy Pastuszak",
  "homepage_url": "https://github.com/apastuszak/thunderbird-filelink-expiring-links",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-filelink-expiring-links@apastuszak",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "cloud_file": {
    "name": "Expiring Links",
    "management_url": "/options/options.html",
    "reuse_uploads": false
  },
  "permissions": ["storage", "notifications", "clipboardWrite", "compose", "accountsRead"],
  "optional_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
